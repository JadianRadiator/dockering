FROM ginuerzh/gost:latest

# Install python3 to run our health check web server
RUN apk add --no-cache python3

# Copy the health check script into the container
COPY health.py /health.py

EXPOSE 8080
EXPOSE 10000

# Run the health web server in the background, and gost in the foreground
CMD ["sh", "-c", "python3 /health.py & /bin/gost -L=http://JadianRadiator:MaJiCkA@:8080"]
