FROM ginuerzh/gost:latest

# Install python3 to manage both processes
RUN apk add --no-cache python3

# Copy our combined router script into the root
COPY health.py /app_health.py

EXPOSE 8080
EXPOSE 10000

# Wipe out the default image entrypoint so Python can run as the main process
ENTRYPOINT []
CMD ["python3", "/app_health.py"]
